# Godot 4 .gitignore
/.godot/*
!/.godot/imported
!/.godot/editor_layout.cfg

*.import
*.tmp
*.bak
*.log

# C# mono cache（GDScript项目也保留，防止后续有人启用C#）
/.mono/

# Export build outputs
/build/
/bin/
/export/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS junk files
.DS_Store
Thumbs.db
