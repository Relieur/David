# Godot 4+ 缓存/生成数据，完全忽略
/.godot/

# Godot 临时文件
# 注意：.import 文件必须提交（含资源 UID 映射），不可忽略
*.tmp
*.bak
*.log

# C# mono cache（GDScript项目也保留，防止后续有人启用C#）
/.mono/

# Export build outputs
/build/
/bin/
/export/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS junk files
.DS_Store
Thumbs.db
